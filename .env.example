# OmniSight-VLM Environment Configuration

# Optional API key protection. Leave empty for open access in local dev.
CCTV_API_KEY=

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost,http://localhost:5173,http://127.0.0.1

# AI Model Configuration
FLORENCE_MODEL_ID=microsoft/Florence-2-base
CAPTION_PROMPT=<MORE_DETAILED_CAPTION>
MAX_NEW_TOKENS=512
