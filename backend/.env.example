# API Key to secure your CCTV Search Backend
# Leave empty for local development without authentication
# CCTV_API_KEY="your-secure-random-key-here"

# Allowed CORS origins for the frontend
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Optional overrides for data directories (defaults to local data folder)
# DATABASE_URL="sqlite:///./data/cctv_search.db"
# CHROMA_DIR="./data/chroma_db"
